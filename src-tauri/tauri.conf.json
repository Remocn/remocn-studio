{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remocn Studio",
  "version": "../package.json",
  "identifier": "com.remocn.remocn-studio",
  "build": {
    "beforeDevCommand": "bun run tauri:before-dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Remocn Studio",
        "visible": false,
        "backgroundColor": "#181818",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 31
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Remocn",
    "homepage": "https://remocn.studio",
    "category": "Video",
    "shortDescription": "Create videos with AI as editable Remotion projects.",
    "longDescription": "Remocn Studio is a desktop app for creating videos with your coding agent. Describe a video, direct changes in a live preview, and export an MP4. Every video is a standard Remotion project stored on your device, with source code you can edit and keep.",
    "copyright": "Copyright (c) 2026 Remocn",
    "license": "MIT",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": { "width": 720, "height": 460 },
        "appPosition": { "x": 190, "y": 230 },
        "applicationFolderPosition": { "x": 530, "y": 230 }
      }
    },
    "targets": "all",
    "externalBin": ["binaries/remocn-studio-bun"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../sidecar-dist/main.js": "sidecar/main.js",
      "../preview/entry.tsx": "preview/entry.tsx",
      "../preview/composition.ts": "preview/composition.ts",
      "../preview/native-entry.tsx": "preview/native-entry.tsx",
      "../preview/surface.ts": "preview/surface.ts",
      "../preview/player-runtime.tsx": "preview/player-runtime.tsx",
      "../preview/managed-transport.ts": "preview/managed-transport.ts",
      "../preview/managed-loader.cjs": "preview/managed-loader.cjs",
      "../preview/native-remotion.ts": "preview/native-remotion.ts",
      "../preview/native-style.ts": "preview/native-style.ts",
      "../preview/frame-clips.ts": "preview/frame-clips.ts",
      "../preview/hidden.ts": "preview/hidden.ts",
      "../preview/anchor.ts": "preview/anchor.ts",
      "../preview/assets.ts": "preview/assets.ts",
      "../preview/bridge.ts": "preview/bridge.ts",
      "../preview/fiber.ts": "preview/fiber.ts",
      "../preview/playback-position.ts": "preview/playback-position.ts",
      "../preview/inspect.ts": "preview/inspect.ts",
      "../preview/inline-text.ts": "preview/inline-text.ts",
      "../preview/geometry.ts": "preview/geometry.ts",
      "../preview/geometry-target.ts": "preview/geometry-target.ts",
      "../preview/transport.ts": "preview/transport.ts",
      "../shared/studio-geometry.ts": "shared/studio-geometry.ts",
      "../preview/interactivity.tsx": "preview/interactivity.tsx",
      "../preview/media-release.ts": "preview/media-release.ts",
      "../preview/presence.ts": "preview/presence.ts",
      "../preview/scenes.ts": "preview/scenes.ts",
      "../preview/playback-rate.ts": "preview/playback-rate.ts",
      "../preview/scenes-report.ts": "preview/scenes-report.ts",
      "../preview/picker.ts": "preview/picker.ts",
      "../preview/managed-objects.ts": "preview/managed-objects.ts",
      "../preview/tuning.ts": "preview/tuning.ts",
      "../preview/tuning-runtime.ts": "preview/tuning-runtime.ts",
      "../preview/snapshot.ts": "preview/snapshot.ts",
      "../preview/source.ts": "preview/source.ts",
      "../preview/stack.ts": "preview/stack.ts",
      "../preview/timing.ts": "preview/timing.ts",
      "../templates/remotion": "templates/remotion",
      "../agent": "agent",
      "../remocn": "remocn"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "desktopTemplate": "linux/remocn-studio.desktop"
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good"],
        "desktopTemplate": "linux/remocn-studio.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["remocn-studio"]
      }
    }
  }
}
