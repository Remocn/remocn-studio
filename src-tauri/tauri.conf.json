{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "remocn-studio",
  "version": "../package.json",
  "identifier": "com.remocn.remocn-studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "remocn studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../sidecar-dist/main.js": "sidecar/main.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
